# Copiar a .env.local. Estos valores llegan al navegador: la autorización real
# depende de RLS, no de ocultar la clave publicable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# La vista mensual requiere un adaptador MonthlySource propio. Mantener apagada
# hasta tenerlo; VITE_MONTHLY_SOURCE solo acepta "supabase" cuando se habilita.
VITE_MONTHLY_ENABLED=false
VITE_MONTHLY_SOURCE=
