# Plantilla combinada para desarrollo local. En despliegue use las plantillas
# específicas app/.env.example y worker/.env.example, y nunca versione valores.

# PWA: la clave publicable se expone al navegador; RLS protege las filas.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
VITE_MONTHLY_ENABLED=false
VITE_MONTHLY_SOURCE=

# Fuente diaria de ventas.
SALES_SOURCE_BASE_URL=https://example.com/sales
SALES_SOURCE_VIEW_LABEL=<sales-view-label>
SALES_SOURCE_HOURLY_PATH=/events/HandleEvent
SALES_SOURCE_HOURLY_QUERY=Obj=<hourly-grid>&Evt=data
SALES_SOURCE_USERNAME=your-sales-username
SALES_SOURCE_PASSWORD=<sales-source-password>

# Fuente de planificación y fichajes.
WORKFORCE_SOURCE_BASE_URL=https://example.com/workforce
WORKFORCE_SOURCE_BUSINESS_ID=your-business-id
WORKFORCE_SOURCE_USERNAME=your-workforce-username
WORKFORCE_SOURCE_PASSWORD=<workforce-source-password>
WORKFORCE_SOURCE_API_KEY=

# Lista JSON sintética: sustituir por locales propios sin datos reales en Git.
RESTAURANTS_JSON=[{"id":"R001","name":"Centro","source_site":"source-site-1","display_order":1,"has_drive_through":false,"workforce_expected_hours":[8,9]}]

# Conexión privada de mínimo privilegio para el worker.
SUPABASE_DB_URL=postgresql://worker:<worker-password>@example.com:5432/postgres

# Nombres excluidos del recuento, separados por ;. Vacía por defecto.
STAFFING_EXCLUDED_PEOPLE=
